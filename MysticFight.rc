#include "resource.h"
#include "winres.h"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//
IDI_ICON1               ICON                    "favicon.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Wave
//
IDR_WAV_LIGHTS_ON       WAVE                    "leds_on.wav"
IDR_WAV_LIGHTS_OFF      WAVE                    "leds_off.wav"

/////////////////////////////////////////////////////////////////////////////
//
// BINARY
//
IDR_MSI_DLL             BINARY                  "MysticLight_SDK.dll"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//
IDD_SETTINGS DIALOGEX 0, 0, 380, 359
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MysticFight Settings - by tonikelope"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
CONTROL         "", IDC_TAB_PROFILES, "SysTabControl32", WS_TABSTOP, 7, 5, 366, 15

// --- PROFILE LAYER ---
LTEXT           "Profile Label:", IDC_LBL_PROFILE_NAME, 15, 27, 80, 8
EDITTEXT        IDC_EDIT_LABEL, 100, 25, 130, 12, ES_AUTOHSCROLL
CONTROL         "Set as Active Profile", IDC_CHK_ACTIVE_PROFILE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 235, 26, 140, 10

// 1. MSI HARDWARE CONTROL
GROUPBOX        "MSI Hardware Control", IDC_GRP_MSI, 7, 45, 366, 65
CONTROL         "Control MSI motherboard", IDC_CHK_CONTROL_MSI, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 56, 180, 10
LTEXT           "Device:", IDC_LBL_DEVICE, 15, 74, 52, 8
COMBOBOX        IDC_COMBO_DEVICE, 70, 72, 295, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT           "Area:", IDC_LBL_AREA, 15, 92, 52, 8
COMBOBOX        IDC_COMBO_AREA, 70, 90, 295, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

// 2. RAZER DEVICES (read-only detection; each supported device is opt-in per profile)
GROUPBOX        "Razer devices", IDC_GRP_RAZER, 7, 115, 366, 50, NOT WS_VISIBLE
CONTROL         "", IDC_LIST_RAZER_DEVICES, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SHOWSELALWAYS | NOT WS_VISIBLE, 15, 128, 350, 28

// 3. DATA SOURCE
GROUPBOX        "Data Source", IDC_GRP_SOURCE, 7, 170, 366, 55
COMBOBOX        IDC_COMBO_DATA_SOURCE, 15, 185, 350, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
COMBOBOX        IDC_SENSOR_ID, 15, 207, 350, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

// 4. THRESHOLDS
GROUPBOX        "Temperature Thresholds and Colors", IDC_GRP_THRESHOLDS, 7, 230, 366, 95
CONTROL         "Use general scheme for all devices", IDC_CHK_USE_GENERAL_THERMAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 240, 260, 10
CONTROL         "", IDC_FRAME_THERMAL_CONTENT, "Static", SS_ETCHEDFRAME, 15, 269, 270, 53
CONTROL         "", IDC_TAB_THERMAL_DEVICES, "SysTabControl32", TCS_BUTTONS | TCS_FLATBUTTONS | TCS_HOTTRACK | WS_TABSTOP, 15, 252, 270, 17

LTEXT           "LOW:", IDC_LBL_LOW, 46, 276, 45, 8
EDITTEXT        IDC_TEMP_LOW, 94, 274, 22, 12, ES_CENTER | ES_NUMBER
LTEXT           "ºC", IDC_LBL_C1, 119, 276, 12, 8
LTEXT           "Color (hex):", IDC_LBL_HEX1, 147, 276, 42, 8
EDITTEXT        IDC_HEX_LOW, 193, 274, 60, 12, ES_CENTER | ES_AUTOHSCROLL | ES_UPPERCASE

LTEXT           "MEDIUM:", IDC_LBL_MED, 46, 293, 45, 8
EDITTEXT        IDC_TEMP_MED, 94, 291, 22, 12, ES_CENTER | ES_NUMBER
LTEXT           "ºC", IDC_LBL_C2, 119, 293, 12, 8
LTEXT           "Color (hex):", IDC_LBL_HEX2, 147, 293, 42, 8
EDITTEXT        IDC_HEX_MED, 193, 291, 60, 12, ES_CENTER | ES_AUTOHSCROLL | ES_UPPERCASE

LTEXT           "HIGH:", IDC_LBL_HIGH, 46, 310, 45, 8
EDITTEXT        IDC_TEMP_HIGH, 94, 308, 22, 12, ES_CENTER | ES_NUMBER
LTEXT           "ºC", IDC_LBL_C3, 119, 310, 12, 8
LTEXT           "Color (hex):", IDC_LBL_HEX3, 147, 310, 42, 8
EDITTEXT        IDC_HEX_HIGH, 193, 308, 60, 12, ES_CENTER | ES_AUTOHSCROLL | ES_UPPERCASE

PUSHBUTTON      "Reset scheme", IDC_BTN_RESET, 295, 253, 70, 14

// --- ADVANCED LAYER (global settings + language, hidden by default) ---
GROUPBOX        "Shared Thermal Engine", IDC_GRP_ADVANCED, 7, 35, 366, 58, NOT WS_VISIBLE
LTEXT           "Sensor Update:", IDC_LBL_ADV_SENSOR, 20, 52, 70, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_SENSOR_UPDATE, 95, 50, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE
LTEXT           "Smoothing:", IDC_LBL_ADV_SMOOTH, 20, 72, 70, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_SMOOTHING, 95, 70, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE
PUSHBUTTON      "Reset Defaults", IDC_BTN_RESET_ADVANCED, 290, 70, 70, 14, NOT WS_VISIBLE

GROUPBOX        "MSI", IDC_GRP_LIGHTING_CONTROLLERS, 7, 98, 366, 56, NOT WS_VISIBLE
LTEXT           "MSI device", IDC_LBL_ADV_LED, 20, 110, 340, 8, SS_NOPREFIX | NOT WS_VISIBLE
LTEXT           "FPS:", IDC_LBL_ADV_MSI_FPS, 20, 129, 25, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_LED_FPS, 50, 127, 65, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE
LTEXT           "On release:", IDC_LBL_ADV_MSI_RELEASE, 130, 129, 55, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_MSI_RELEASE, 190, 127, 170, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE

GROUPBOX        "Razer", IDC_GRP_ADV_RAZER_CONTROLLER, 7, 159, 366, 64, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_RAZER_DEVICE, 20, 172, 340, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE
LTEXT           "FPS:", IDC_LBL_ADV_RAZER, 20, 201, 25, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_RAZER_FPS, 50, 199, 65, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE
LTEXT           "On release:", IDC_LBL_ADV_RAZER_RELEASE, 130, 201, 55, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_RAZER_RELEASE, 190, 199, 170, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE

GROUPBOX        "Data Sources", IDC_GRP_DATA_SOURCES, 7, 228, 366, 45, NOT WS_VISIBLE
LTEXT           "LibreHardwareMonitor", IDC_LBL_LHM_SERVER, 20, 246, 100, 8, NOT WS_VISIBLE
EDITTEXT        IDC_EDIT_LHM_SERVER, 125, 244, 235, 12, ES_AUTOHSCROLL | NOT WS_VISIBLE

GROUPBOX        "Language", IDC_GRP_LANGUAGE, 7, 278, 366, 45, NOT WS_VISIBLE
LTEXT           "Language:", IDC_LBL_LANGUAGE, 20, 296, 70, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_LANGUAGE, 95, 294, 120, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE

// --- SHORTCUTS LAYER ---
GROUPBOX        "Global Hotkeys Configuration", IDC_GRP_SHORTCUTS, 7, 30, 366, 185, NOT WS_VISIBLE

LTEXT           "Toggle ON/OFF:", IDC_LBL_TOGGLE, 20, 50, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_TOGGLE, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 48, 180, 14

LTEXT           "Activate Profile 1:", IDC_LBL_P1, 20, 75, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_P1, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 73, 180, 14

LTEXT           "Activate Profile 2:", IDC_LBL_P2, 20, 100, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_P2, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 98, 180, 14

LTEXT           "Activate Profile 3:", IDC_LBL_P3, 20, 125, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_P3, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 123, 180, 14

LTEXT           "Activate Profile 4:", IDC_LBL_P4, 20, 150, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_P4, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 148, 180, 14

LTEXT           "Activate Profile 5:", IDC_LBL_P5, 20, 175, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_P5, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 173, 180, 14

PUSHBUTTON      "Reset Hotkeys", IDC_BTN_RESET_SHORTCUTS, 270, 195, 70, 14, NOT WS_VISIBLE

// Buttons
CONTROL         "Run on Windows startup", IDC_CHK_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 340, 150, 10
CONTROL         "Show notifications", IDC_CHK_NOTIFICATIONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 165, 340, 95, 10
DEFPUSHBUTTON   "Save", IDOK, 268, 337, 52, 14
PUSHBUTTON      "Cancel", IDCANCEL, 323, 337, 52, 14
END


IDD_ABOUT DIALOGEX 0, 0, 190, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About MysticFight"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_ABOUT_ICON, "Static", SS_ICON | SS_REALSIZEIMAGE, 15, 15, 32, 32
    LTEXT           "", IDC_ABOUT_VERSION, 55, 15, 120, 8, SS_NOPREFIX
    LTEXT           "By tonikelope", IDC_ABOUT_BY, 55, 26, 120, 8
    LTEXT           "MSI Mystic Light Temperature Profile Replacement", IDC_ABOUT_DESC, 55, 40, 120, 20
    LTEXT           "Visit GitHub Project", IDC_GITHUB_LINK, 55, 65, 120, 8, SS_NOTIFY
    DEFPUSHBUTTON   "Close", IDOK, 133, 89, 50, 14
END
