#include "resource.h"
#include "winres.h"

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//
IDI_ICON1               ICON                    "favicon.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Wave
//
IDR_WAV_LIGHTS_ON       WAVE                    "leds_on.wav"
IDR_WAV_LIGHTS_OFF      WAVE                    "leds_off.wav"

/////////////////////////////////////////////////////////////////////////////
//
// BINARY
//
IDR_MSI_DLL             BINARY                  "MysticLight_SDK.dll"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//
IDD_SETTINGS DIALOGEX 0, 0, 450, 359
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MysticFight Settings - by tonikelope"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
// Profiles scroll independently; creation, Shortcuts and Advanced stay pinned.
CONTROL         "", IDC_TAB_PROFILES, "SysTabControl32", WS_TABSTOP, 7, 5, 300, 15
CONTROL         "", IDC_TAB_SETTINGS_ACTIONS, "SysTabControl32", WS_TABSTOP, 307, 5, 136, 15

// --- PROFILE LAYER ---
LTEXT           "Profile Label:", IDC_LBL_PROFILE_NAME, 15, 27, 80, 8
EDITTEXT        IDC_EDIT_LABEL, 100, 25, 130, 12, ES_AUTOHSCROLL
CONTROL         "Set as Active Profile", IDC_CHK_ACTIVE_PROFILE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 235, 26, 128, 10
CONTROL         "Delete profile", IDC_BTN_DELETE_PROFILE, "Button", BS_OWNERDRAW | WS_TABSTOP, 365, 24, 70, 14

// 1. RGB DEVICES
GROUPBOX        "RGB Devices", IDC_GRP_RGB_DEVICES, 7, 44, 436, 120
GROUPBOX        "MSI Hardware Control", IDC_GRP_MSI, 15, 53, 420, 59
CONTROL         "Control MSI motherboard", IDC_CHK_CONTROL_MSI, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 23, 63, 180, 10
LTEXT           "Device:", IDC_LBL_DEVICE, 23, 81, 52, 8
COMBOBOX        IDC_COMBO_DEVICE, 78, 79, 349, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT           "Area:", IDC_LBL_AREA, 23, 99, 52, 8
COMBOBOX        IDC_COMBO_AREA, 78, 97, 349, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

// 2. RAZER DEVICES (read-only detection; each supported device is opt-in per profile)
GROUPBOX        "Razer devices", IDC_GRP_RAZER, 15, 116, 420, 44, NOT WS_VISIBLE
CONTROL         "", IDC_LIST_RAZER_DEVICES, "SysListView32", WS_BORDER | WS_TABSTOP | LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SHOWSELALWAYS | NOT WS_VISIBLE, 23, 127, 404, 27

CONTROL         "", IDC_SEPARATOR_PROFILE, "Static", SS_ETCHEDHORZ, 7, 168, 436, 1

// 3. PER-CONTROLLER THERMAL SCHEME
GROUPBOX        "Thermal scheme", IDC_GRP_THRESHOLDS, 7, 174, 436, 151
CONTROL         "Use the same scheme for all devices", IDC_CHK_USE_GENERAL_THERMAL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 15, 184, 260, 10
GROUPBOX        "Data Source", IDC_GRP_SOURCE, 15, 214, 340, 44
COMBOBOX        IDC_COMBO_DATA_SOURCE, 23, 225, 324, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
COMBOBOX        IDC_SENSOR_ID, 23, 242, 324, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
CONTROL         "", IDC_FRAME_THERMAL_CONTENT, "Static", SS_ETCHEDFRAME, 15, 262, 340, 60
CONTROL         "", IDC_TAB_THERMAL_DEVICES, "SysTabControl32", TCS_BUTTONS | TCS_FLATBUTTONS | TCS_HOTTRACK | WS_TABSTOP, 15, 196, 340, 17

LTEXT           "LOW:", IDC_LBL_LOW, 81, 272, 45, 8
EDITTEXT        IDC_TEMP_LOW, 129, 270, 22, 12, ES_CENTER | ES_NUMBER
LTEXT           "ºC", IDC_LBL_C1, 154, 272, 12, 8
LTEXT           "Color (hex):", IDC_LBL_HEX1, 182, 272, 42, 8
EDITTEXT        IDC_HEX_LOW, 228, 270, 60, 12, ES_CENTER | ES_AUTOHSCROLL | ES_UPPERCASE

LTEXT           "MEDIUM:", IDC_LBL_MED, 81, 289, 45, 8
EDITTEXT        IDC_TEMP_MED, 129, 287, 22, 12, ES_CENTER | ES_NUMBER
LTEXT           "ºC", IDC_LBL_C2, 154, 289, 12, 8
LTEXT           "Color (hex):", IDC_LBL_HEX2, 182, 289, 42, 8
EDITTEXT        IDC_HEX_MED, 228, 287, 60, 12, ES_CENTER | ES_AUTOHSCROLL | ES_UPPERCASE

LTEXT           "HIGH:", IDC_LBL_HIGH, 81, 306, 45, 8
EDITTEXT        IDC_TEMP_HIGH, 129, 304, 22, 12, ES_CENTER | ES_NUMBER
LTEXT           "ºC", IDC_LBL_C3, 154, 306, 12, 8
LTEXT           "Color (hex):", IDC_LBL_HEX3, 182, 306, 42, 8
EDITTEXT        IDC_HEX_HIGH, 228, 304, 60, 12, ES_CENTER | ES_AUTOHSCROLL | ES_UPPERCASE

PUSHBUTTON      "Reset scheme", IDC_BTN_RESET, 365, 197, 70, 14

// --- ADVANCED LAYER (global settings + language, hidden by default) ---
GROUPBOX        "Shared Thermal Engine", IDC_GRP_ADVANCED, 7, 35, 436, 58, NOT WS_VISIBLE
LTEXT           "Sensor Update:", IDC_LBL_ADV_SENSOR, 20, 52, 70, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_SENSOR_UPDATE, 95, 50, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE
LTEXT           "Smoothing:", IDC_LBL_ADV_SMOOTH, 20, 72, 70, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_SMOOTHING, 95, 70, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE
PUSHBUTTON      "Reset Defaults", IDC_BTN_RESET_ADVANCED, 360, 70, 70, 14, NOT WS_VISIBLE

GROUPBOX        "MSI", IDC_GRP_LIGHTING_CONTROLLERS, 7, 98, 436, 56, NOT WS_VISIBLE
LTEXT           "MSI device", IDC_LBL_ADV_LED, 20, 110, 410, 8, SS_NOPREFIX | NOT WS_VISIBLE
LTEXT           "FPS:", IDC_LBL_ADV_MSI_FPS, 20, 129, 25, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_LED_FPS, 50, 127, 65, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE
LTEXT           "On release:", IDC_LBL_ADV_MSI_RELEASE, 130, 129, 55, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_MSI_RELEASE, 190, 127, 240, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE

GROUPBOX        "Razer", IDC_GRP_ADV_RAZER_CONTROLLER, 7, 159, 436, 64, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_RAZER_DEVICE, 20, 172, 410, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE
LTEXT           "FPS:", IDC_LBL_ADV_RAZER, 20, 201, 25, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_RAZER_FPS, 50, 199, 65, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE
LTEXT           "On release:", IDC_LBL_ADV_RAZER_RELEASE, 130, 201, 55, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_RAZER_RELEASE, 190, 199, 240, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE

GROUPBOX        "Data Sources", IDC_GRP_DATA_SOURCES, 7, 228, 436, 45, NOT WS_VISIBLE
LTEXT           "LibreHardwareMonitor", IDC_LBL_LHM_SERVER, 20, 246, 100, 8, NOT WS_VISIBLE
EDITTEXT        IDC_EDIT_LHM_SERVER, 125, 244, 305, 12, ES_AUTOHSCROLL | NOT WS_VISIBLE

GROUPBOX        "Language", IDC_GRP_LANGUAGE, 7, 278, 436, 45, NOT WS_VISIBLE
LTEXT           "Language:", IDC_LBL_LANGUAGE, 20, 296, 70, 8, NOT WS_VISIBLE
COMBOBOX        IDC_COMBO_LANGUAGE, 95, 294, 120, 60, CBS_DROPDOWNLIST | WS_TABSTOP | NOT WS_VISIBLE

// --- SHORTCUTS LAYER ---
GROUPBOX        "Global Hotkeys Configuration", IDC_GRP_SHORTCUTS, 7, 30, 436, 185, NOT WS_VISIBLE

LTEXT           "CAPTURE MODE ACTIVE", IDC_LBL_HOTKEY_CAPTURE, 120, 36, 250, 8, SS_CENTER | NOT WS_VISIBLE

LTEXT           "Toggle ON/OFF:", IDC_LBL_TOGGLE, 20, 50, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_TOGGLE, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 48, 250, 14

LTEXT           "Activate Profile 1:", IDC_LBL_P1, 20, 75, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_P1, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 73, 250, 14

LTEXT           "Activate Profile 2:", IDC_LBL_P2, 20, 100, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_P2, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 98, 250, 14

LTEXT           "Activate Profile 3:", IDC_LBL_P3, 20, 125, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_P3, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 123, 250, 14

LTEXT           "Activate Profile 4:", IDC_LBL_P4, 20, 150, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_P4, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 148, 250, 14

LTEXT           "Activate Profile 5:", IDC_LBL_P5, 20, 175, 80, 8, NOT WS_VISIBLE
CONTROL         "", IDC_HK_P5, "msctls_hotkey32", WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 120, 173, 250, 14

SCROLLBAR       IDC_SCROLL_HOTKEY_PROFILES, 410, 72, 12, 115, SBS_VERT | WS_TABSTOP | NOT WS_VISIBLE

PUSHBUTTON      "Reset Hotkeys", IDC_BTN_RESET_SHORTCUTS, 360, 195, 70, 14, NOT WS_VISIBLE

// Buttons
CONTROL         "Run on Windows startup", IDC_CHK_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 340, 150, 10
CONTROL         "Show notifications", IDC_CHK_NOTIFICATIONS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 165, 340, 95, 10
DEFPUSHBUTTON   "Save", IDOK, 338, 337, 52, 14
PUSHBUTTON      "Cancel", IDCANCEL, 393, 337, 52, 14
END


IDD_ABOUT DIALOGEX 0, 0, 190, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About MysticFight"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_ABOUT_ICON, "Static", SS_ICON | SS_REALSIZEIMAGE, 15, 15, 32, 32
    LTEXT           "", IDC_ABOUT_VERSION, 55, 15, 120, 8, SS_NOPREFIX
    LTEXT           "By tonikelope", IDC_ABOUT_BY, 55, 26, 120, 8
    LTEXT           "MSI Mystic Light Temperature Profile Replacement", IDC_ABOUT_DESC, 55, 40, 120, 20
    LTEXT           "Visit GitHub Project", IDC_GITHUB_LINK, 55, 65, 120, 8, SS_NOTIFY
    DEFPUSHBUTTON   "Close", IDOK, 133, 89, 50, 14
END
